{
  "name": "bobby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bobby: an open-source, single-user, local-first AI chess learning app.",
  "license": "GPL-3.0-only",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "smoke": "node tests/smoke.mjs",
    "calibrate": "node scripts/calibrate-strength.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "chess.js": "^1.4.0",
    "dexie": "^4.4.7",
    "pyodide": "^0.29.3",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.3",
    "react-dom": "^18.3.1",
    "stockfish": "^18.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.21"
  }
}
